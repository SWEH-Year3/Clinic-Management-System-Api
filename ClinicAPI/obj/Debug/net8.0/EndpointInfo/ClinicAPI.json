            "format": "password"
          },
          "name": {
            "minLength": 1,
            "type": "string",
            "format": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "phone": {
            "minLength": 1,
            "type": "string",
            "format": "tel"
